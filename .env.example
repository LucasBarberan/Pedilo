# Backend API (Pos-Backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# URL pública de esta app (usada en metadata/SEO y links de seguimiento)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identidad del comercio — se carga manualmente por negocio
NEXT_PUBLIC_STORE_NAME="Mi Negocio"
NEXT_PUBLIC_STORE_DESCRIPTION="Pedí online. Delivery y retiro en local."
NEXT_PUBLIC_BRAND_COLOR="#ff903b"

# Google Maps — autocomplete de dirección y mapa de confirmación en checkout
# Key restringida por HTTP referrer en Google Cloud Console, scope SOLO Places API.
NEXT_PUBLIC_GOOGLE_MAPS_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Cookies del login de técnico (/tecnico) — true en producción (HTTPS)
COOKIE_SECURE=false

# Modo de catálogo/checkout del negocio — independientes entre sí, ninguna
# deriva de la otra. Se configuran por deployment, no cambian en caliente.
# NEXT_PUBLIC_STORE_MODE: "" (default, catálogo normal) | "wholesale"
#   (catálogo simple sin Observaciones, muestra stock, checkout pide DNI)
NEXT_PUBLIC_STORE_MODE=wholesale
# NEXT_PUBLIC_TABLE_RESERVATIONS: "off" (default, sin pantalla de entrada) |
#   "on" (pantalla de entrada con opción "Reservar mesa" habilitada) |
#   "coming_soon" (pantalla de entrada con "Reservar mesa" deshabilitada)
NEXT_PUBLIC_TABLE_RESERVATIONS=coming_soon
