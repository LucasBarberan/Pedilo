# Pedilo — IMAGEN ÚNICA para todos los clientes (change infra-multi-tenant, Fase 4, tarea 4.11).
#
# A diferencia de `dockerfile` (un build por cliente con sus NEXT_PUBLIC_* horneados), esta imagen NO lleva ningún dato de un cliente:
# marca, direcciones y claves públicas se resuelven al ejecutar, por dominio (ver lib/runtimeConfig.ts). Se construye UNA vez y se usa
# para todos los clientes.
#
# Variables de EJECUCIÓN (solo servidor; no son NEXT_PUBLIC_*):
#   TENANCY_MODE=multi
#   BACKEND_INTERNAL_URL=http://backend:5000/api     (red interna del Backend compartido)
#   INTERNAL_API_KEY=...                              (la misma clave que habilita X-Keltron-Host en el Backend)

# ===== deps =====
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
# IMPORTANTE: sharp debe estar en "dependencies" del package.json
RUN npm ci --legacy-peer-deps

# ===== build =====
FROM node:20-alpine AS build
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Sin `ARG NEXT_PUBLIC_*` por cliente: ninguna dirección, nombre ni color entra al build.
# `public/brand/` (logos de un cliente, ignorado por git y copiado desde la carpeta de despliegue) NO viaja en la imagen compartida:
# el logo de cada cliente sale de su Backend (`logoUrl`).
RUN rm -rf public/brand && rm -f .env .env.* && npm run build

# ===== run =====
FROM node:20-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV TENANCY_MODE=multi

# Recomendado para sharp en Alpine (musl)
RUN apk add --no-cache libc6-compat

COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

RUN mkdir -p .next/cache/images && chown -R node:node /app/.next

USER node

EXPOSE 3000
CMD ["node", "server.js"]
